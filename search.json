---
layout: none
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | absolute_url | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "content": {{ post.excerpt | strip_html | jsonify }}
  }{% if forloop.last == false %},{% endif %}
{% endfor %}
]
